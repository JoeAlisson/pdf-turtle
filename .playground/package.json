{
  "name": "pdf-turtle-playground",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf ./app/swagger-client/**",
    "generate-openapi-client": "node ./swagger/codegen.js",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,ts,vue}": [
      "npx prettier --write",
      "npx eslint --fix"
    ]
  },
  "dependencies": {
    "@quasar/extras": "^2.0.4",
    "axios": "^1.20.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.56.0",
    "quasar": "^2.30.1",
    "uuid": "^14.0.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/file-saver": "^2.0.7",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.5.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "sass-loader": "^17.0.1",
    "swagger-axios-codegen": "^0.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.13"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
